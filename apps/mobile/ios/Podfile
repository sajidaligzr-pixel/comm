# firebase_core (and several of its siblings) require iOS 15+ as of their current
# pinned versions — found via a real `flutter build ios` attempt, not guessed
# (CocoaPods refused to resolve at the default 13.0). Matches the deployment
# target already bumped to 15.0 in Runner.xcodeproj/project.pbxproj.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # permission_handler compiles every permission group's real implementation
    # out entirely (down to an empty stub class with no methods at all — see
    # permission_handler_apple's strategies/*.m, each wrapped in
    # `#if PERMISSION_X ... #else @implementation ... @end #endif`) unless its
    # macro is defined here — this is required setup on iOS specifically, per
    # the package's own README, that this Podfile never had. Found live: on the
    # very first real-device iOS build, Permission.microphone.request() (calls,
    # voice notes) and Permission.locationWhenInUse.request() (live location
    # sharing) both silently misbehaved instead of prompting, and the app
    # crashed outright reaching into the still-declared-but-unimplemented
    # method on the stub class. Only the three groups this app's Dart code
    # actually calls (see the exact `Permission.*` call sites) are enabled —
    # matches this project's "don't over-ask for what isn't used" rule.
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] += [
        'PERMISSION_MICROPHONE=1',   # Permission.microphone — calls, voice notes
        'PERMISSION_LOCATION=1',     # Permission.locationWhenInUse — live location sharing
        'PERMISSION_BLUETOOTH=1',    # Permission.bluetoothConnect — call audio routed to a headset
      ]
    end
  end
end
