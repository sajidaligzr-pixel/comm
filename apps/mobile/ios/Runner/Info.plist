<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Comm Mobile</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>comm_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Required by image_picker (features/chats/thread_screen.dart's "Photo" attach
	     option) — iOS crashes the app outright if this key is missing at the moment
	     the photo library is actually accessed, not just denies the permission. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Comm needs access to your photos so you can send them in a chat.</string>
	<!-- Required by flutter_webrtc's getUserMedia (features/calls/) — same
	     crash-not-just-deny behavior as the photo library key above. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Comm needs access to your microphone to make and receive voice calls.</string>
	<!-- Required by BOTH image_picker's camera-capture option (not just its photo-
	     library option above — thread_screen.dart's "Photo" attach action lets you
	     take a new photo, not only pick an existing one) and flutter_webrtc's
	     getUserMedia for video calls (features/calls/) — missing entirely was a
	     real App Store rejection (ITMS-90683), not a guess: Apple's own binary
	     validation caught a reference to a camera-requiring API with no matching
	     purpose string. -->
	<key>NSCameraUsageDescription</key>
	<string>Comm needs access to your camera to take photos to send in a chat and for video calls.</string>
	<!-- Required by local_auth (features/auth/biometric_unlock.dart) for Face ID
	     specifically — Touch ID needs no key, but without this one iOS shows a
	     dialog saying the app hasn't been updated to support Face ID instead of
	     the actual prompt. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Comm can use Face ID to unlock the app instead of your password.</string>
	<!-- Live location sharing (features/location/, docs/09-trust-boundaries.md's
	     explicit exception) — geolocator/permission_handler's
	     Permission.locationWhenInUse.request() surfaces this description; iOS
	     crashes the app outright (not just denies) if it's missing when location is
	     first accessed, same class of requirement as the photo-library key above. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Comm shares your live location with this app's admins while you're using the app.</string>
	<!-- Shown for the separate, later "Always" follow-up prompt
	     (Permission.locationAlways.request()) that lets location keep being shared
	     while the app is backgrounded/closed — the two-step disclosure iOS requires
	     for background location access, matching Android's separate
	     ACCESS_BACKGROUND_LOCATION permission. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Comm shares your live location with this app's admins continuously, including while the app is closed.</string>
	<!-- Lets a push actually wake the app to run firebaseMessagingBackgroundHandler
	     (features/notifications/push_notifications.dart) while backgrounded, not just
	     while foregrounded — the iOS half of what AndroidManifest.xml's equivalent
	     already covers. Requires the Push Notifications capability + a real APNs
	     entitlement to do anything (see Runner.entitlements) — inert without those,
	     not harmful to have present ahead of them.
	     `location` is location_service.dart's own background mode (features/location/)
	     — lets the app keep receiving location updates while backgrounded, subject to
	     iOS's own throttling of exactly how often (see that file's docstring).
	     `voip` is PushKit's own required background mode (AppDelegate.swift,
	     call_kit.dart) — without it, a VoIP push is delivered to a suspended/killed
	     app but the OS never actually wakes it to run didReceiveIncomingPushWith,
	     silently defeating the entire feature. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>location</string>
		<string>voip</string>
	</array>
	<!-- Export compliance — every encrypted app hits App Store Connect's "Missing
	     Compliance" step on its first upload without this key (found live,
	     build 1.0.0 (15)'s first TestFlight upload). `false` here means "does not
	     use non-exempt encryption" — accurate for this app: every crypto primitive
	     it uses (X25519/Ed25519/ChaCha20-Poly1305/HKDF/Argon2id — packages/crypto,
	     mirrored in lib/crypto/) is a standard, publicly documented algorithm used
	     for user authentication and data confidentiality, which is exactly the
	     U.S. EAR §740.17 "mass market"/exempt category every mainstream encrypted
	     messaging app (Signal, WhatsApp, etc.) self-classifies under — not
	     custom/proprietary cryptography, which would need a real export
	     classification filing instead. Setting this makes every future build skip
	     the manual questionnaire in App Store Connect. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
