<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for every network call this app makes (API, media upload/download,
         realtime WebSocket) — Flutter's tooling auto-adds this for debug/profile
         builds only (see src/debug and src/profile's own manifests, which exist
         purely for hot-reload's own connection), so a release build silently has NO
         network access at all without it declared here too. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Voice calling (features/calls/) — flutter_webrtc's getUserMedia needs mic
         access; MODIFY_AUDIO_SETTINGS backs Helper.setSpeakerphoneOn's earpiece/
         speaker toggle. Requested at runtime too (permission_handler, in
         CallController._ensureMicPermission) — the manifest entry alone only
         declares intent, Android still prompts the user the first time. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- Biometric unlock (features/auth/biometric_unlock.dart) — local_auth's
         BiometricPrompt integration needs this declared or the prompt silently
         refuses to show on API 28+. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Local message notifications (features/notifications/) — required at
         runtime on Android 13+ (API 33), requested explicitly in
         local_notifications.dart's initLocalNotifications; this declaration alone
         only states intent, same as RECORD_AUDIO above. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- In-app update prompt (features/update/) — this app is sideloaded, not
         Play-Store-distributed, so installing a newer APK the user opted into via
         the update banner needs this explicitly; without it, Android silently
         refuses the install intent on API 26+ regardless of what the user taps. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Live location sharing (features/location/, docs/09-trust-boundaries.md's
         explicit exception) — FINE/COARSE requested at runtime
         (permissions_prompt.dart), read by both geolocator (foreground use) and
         LocationForegroundService.kt's own direct FusedLocationProviderClient
         calls. BACKGROUND_LOCATION is declared but deliberately NOT requested at
         runtime as of build 1.0.0+14 — a location-type foreground service (below)
         gets background access on WHILE_IN_USE alone for as long as it runs, so
         requesting the separate "Always" permission would be asking for
         something this app doesn't actually use (see permissions_prompt.dart's
         own docstring). Left declared rather than removed in case a future
         redesign needs it again. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <!-- Required for LocationForegroundService.kt to keep running (and posting
         fixes) while the app is backgrounded — the FOREGROUND_SERVICE_LOCATION
         variant is Android 14+'s required, narrower declaration of WHICH kind
         of foreground service this is, alongside the general one. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- CallForegroundService.kt — keeps this app's process exempt from Doze/App
         Standby CPU throttling for the duration of an active voice call, so
         flutter_webrtc's audio pipeline keeps running when the screen turns off or
         the app is backgrounded. Found live: "the voice does not go" in exactly
         those two situations, with no foreground service of any kind covering an
         active call (only LocationForegroundService's `location` type existed). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- Lets features/permissions/permissions_prompt.dart's onboarding card ask
         the user to exempt this app from Doze/App Standby battery restrictions
         (Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, wrapped by
         permission_handler's Permission.ignoreBatteryOptimizations). Found live:
         without this exemption, a call push (FCM data message, high-priority)
         can still reach a backgrounded/closed app's native layer but never
         reliably reach the point of actually showing the CallKit ringing UI —
         confirmed on a real device via adb (dumpsys deviceidle whitelist showed
         this app absent while e.g. Life360 was present), and fixed the instant
         the app was added to that same whitelist. Google Play's Battery policy
         explicitly permits this permission for apps whose "core functionality
         could be impaired" by battery optimization, naming VoIP/real-time-
         communication apps as the intended exception — which this app's calling
         feature squarely is, not a generic battery-life workaround. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <application
        android:label="Comm"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- launchMode singleInstance (was singleTop) — required by flutter_callkit_incoming
             (features/calls/call_kit.dart): its own incoming-call Activity is declared
             singleInstance in the plugin's manifest, and the plugin's install docs call
             out this exact change to MainActivity as required alongside it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- In-app update prompt (features/update/apk_installer.dart) — Android's
             package installer needs a content:// URI, not a bare file:// path (blocked
             by FileUriExposedException on API 24+); this FileProvider is what turns
             the downloaded APK (written to this app's own private cache dir, so no
             READ/MANAGE_EXTERNAL_STORAGE permission is needed at all) into one. The
             authorities value and file_paths.xml's <cache-path> together determine
             the exact content:// URI apk_installer.dart constructs by hand — see that
             file's own comment for why it's built manually rather than through a
             plugin (no cross-platform-safe way to call FileProvider.getUriForFile()
             from Dart directly without writing native platform-channel code for
             something this small). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- LocationForegroundService (android/app/src/main/kotlin/.../LocationForegroundService.kt)
             — a plain, hand-written foreground service; replaced flutter_background_service
             as of build 1.0.0+14 after that plugin's own background-isolate mechanism was
             confirmed (by reading its source) to crash the app on open. Not exported —
             nothing outside this app ever starts/stops it directly, only
             MainActivity's MethodChannel handler does. -->
        <service
            android:name=".LocationForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />
        <!-- CallForegroundService (android/app/src/main/kotlin/.../CallForegroundService.kt)
             — started/stopped only from CallController via MainActivity's MethodChannel,
             for exactly the duration of an active call. -->
        <service
            android:name=".CallForegroundService"
            android:foregroundServiceType="microphone"
            android:exported="false" />
        <!-- flutter_callkit_incoming (features/calls/call_kit.dart) declares its own
             Activity/Service/ConnectionService/receiver in its own AndroidManifest.xml,
             auto-merged into this one by Gradle — nothing to add here by hand for it.
             No <receiver> for flutter_local_notifications' own ActionBroadcastReceiver
             either: that was only ever needed for the call notification's Accept/
             Decline action buttons (removed along with the rest of the call-channel
             flutter_local_notifications code — see call_kit.dart's docstring for why),
             and it's what surfaced the "nothing happens when clicking Decline" bug in
             the first place when it was undeclared — a plain notification tap (the only
             thing flutter_local_notifications still does, for messages) never goes
             through this component at all. Re-add it if a future notification action
             button needs it again. -->
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
