<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for every network call this app makes (API, media upload/download,
         realtime WebSocket) — Flutter's tooling auto-adds this for debug/profile
         builds only (see src/debug and src/profile's own manifests, which exist
         purely for hot-reload's own connection), so a release build silently has NO
         network access at all without it declared here too. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Voice calling (features/calls/) — flutter_webrtc's getUserMedia needs mic
         access; MODIFY_AUDIO_SETTINGS backs Helper.setSpeakerphoneOn's earpiece/
         speaker toggle. Requested at runtime too (permission_handler, in
         CallController._ensureMicPermission) — the manifest entry alone only
         declares intent, Android still prompts the user the first time. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- Biometric unlock (features/auth/biometric_unlock.dart) — local_auth's
         BiometricPrompt integration needs this declared or the prompt silently
         refuses to show on API 28+. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Local message notifications (features/notifications/) — required at
         runtime on Android 13+ (API 33), requested explicitly in
         local_notifications.dart's initLocalNotifications; this declaration alone
         only states intent, same as RECORD_AUDIO above. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="Comm"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- launchMode singleInstance (was singleTop) — required by flutter_callkit_incoming
             (features/calls/call_kit.dart): its own incoming-call Activity is declared
             singleInstance in the plugin's manifest, and the plugin's install docs call
             out this exact change to MainActivity as required alongside it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- flutter_callkit_incoming (features/calls/call_kit.dart) declares its own
             Activity/Service/ConnectionService/receiver in its own AndroidManifest.xml,
             auto-merged into this one by Gradle — nothing to add here by hand for it.
             No <receiver> for flutter_local_notifications' own ActionBroadcastReceiver
             either: that was only ever needed for the call notification's Accept/
             Decline action buttons (removed along with the rest of the call-channel
             flutter_local_notifications code — see call_kit.dart's docstring for why),
             and it's what surfaced the "nothing happens when clicking Decline" bug in
             the first place when it was undeclared — a plain notification tap (the only
             thing flutter_local_notifications still does, for messages) never goes
             through this component at all. Re-add it if a future notification action
             button needs it again. -->
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
