{
  "name": "@comm/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background jobs — see docs/01-folder-structure.md. Phase 2 only needs periodic cleanup (no queue producers exist yet); BullMQ is adopted starting Phase 4 when media processing actually enqueues jobs, not before.",
