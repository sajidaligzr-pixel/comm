    "lint": "eslint ."
  },
  "dependencies": {
    "@comm/database": "*",
    "@comm/security": "*",
    "@comm/storage": "*",
    "@comm/types": "*",
    "dotenv": "^16.4.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@comm/config": "*",
    "@types/node": "^22.7.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
