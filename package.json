{
  "name": "comm",
  "private": true,
  "type": "module",
  "description": "Comm — a closed, privacy-first, end-to-end encrypted messaging platform.",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:security": "turbo run test:security",
    "db:generate": "npm run generate --workspace=@comm/database",
    "db:migrate": "npm run migrate:dev --workspace=@comm/database",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=@comm/database",
    "db:studio": "npm run studio --workspace=@comm/database"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "eslint": "^9.13.0"
  }
}
