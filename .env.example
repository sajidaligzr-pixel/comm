# Copy this file to .env and fill in real values. Never commit .env.
# See docs/11-deployment-architecture.md for how each of these is provisioned in production.

# --- Database (packages/database, apps/api, apps/worker) ---
# Local dev default (see docs/11): a native Postgres install, dedicated low-privilege role/db.
# Production: a managed Postgres provider, private networking, encrypted connections.
DATABASE_URL="postgresql://comm_app:CHANGE_ME@localhost:5432/comm_dev"
# Dev-only: used by `prisma migrate dev`'s shadow-database drift check, which needs a
# role with CREATEDB. The app itself never uses this — see the comment in
# packages/database/prisma/schema.prisma. Leave unset in production.
SHADOW_DATABASE_URL="postgresql://postgres@localhost:5432/comm_shadow"

# --- Redis (apps/api, apps/worker: pubsub, queues, rate limiting, presence/typing TTLs) ---
REDIS_URL="redis://localhost:6379"

# --- Auth (apps/api) ---
# Signs short-lived access tokens. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET"
JWT_ACCESS_TTL="15m"
# Refresh tokens are opaque random values hashed at rest — no signing secret needed for them.
REFRESH_TOKEN_TTL_DAYS="30"
INVITE_TOKEN_TTL_HOURS="72"

# CSRF double-submit cookie secret. Generate with: openssl rand -base64 32
CSRF_SECRET="CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET"

# --- Argon2id parameters (docs/07-auth-architecture.md) ---
# Tune against actual production hardware before launch; see docs/14-risk-register.md #12.
ARGON2_MEMORY_KIB="65536"
ARGON2_ITERATIONS="3"
ARGON2_PARALLELISM="1"

# --- Object storage (docs/13's file-attachment pass, shipped ahead of the rest of
# Phase 4 — real S3-compatible upload/download, replacing the inline-ciphertext
# trick voice/images still use for their own separate, unaffected path) ---
# Leave all four unset for local dev: apps/web/server/modules/media/storage.ts falls
# back to a zero-setup local-filesystem adapter (files under apps/web/.data/, never
# committed) — same "configured -> real, unset -> dev-safe default" pattern as
# TURN_SHARED_SECRET/VAPID_* below. Set all four to switch to real S3/R2/etc in
# production — see docs/11-deployment-architecture.md.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
# 'auto' is the conventional placeholder R2/MinIO-style endpoints document for this
# field; a real AWS S3 bucket should set its actual region instead.
OBJECT_STORAGE_REGION="auto"
# Per-file cap enforced server-side regardless of what a client declares — see
# apps/web/server/modules/media/service.ts.
MEDIA_MAX_UPLOAD_BYTES="26214400"
# Per-ACCOUNT running-total cap on currently-live (non-expired) attachment bytes —
# docs/10-privacy-data-retention.md's media retention pass. Matters most for the
# local-fs storage adapter (self-hosted disk is finite); tune this to your actual
# available disk, not just the default. 524288000 = 500 MiB.
MEDIA_ACCOUNT_QUOTA_BYTES="524288000"

# --- coturn (docs/11) ---
# POST /api/calls/turn-credentials (calling is shipped, docs/13's "Voice calling
# pass") reads these to mint short-lived credentials. Left unset/CHANGE_ME, that
# route returns an empty ICE server list — calls still work on the same network
# (host candidates), just not across arbitrary real-world NATs until a coturn
# instance is actually deployed and these point at it.
TURN_SHARED_SECRET="CHANGE_ME"
TURN_URLS="turn:your-coturn-host:3478"

# --- Web Push (docs/13's "Push notifications" pass, shipped ahead of the rest of
# Phase 7 — no preferences UI, just: new message -> push) — the browser client path.
# Generate a keypair with: npx web-push generate-vapid-keys --json
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY are read by apps/worker to sign outgoing push
# requests. NEXT_PUBLIC_VAPID_PUBLIC_KEY is the exact same public key, duplicated
# under the NEXT_PUBLIC_ prefix so the browser bundle (apps/web) can pass it to
# `pushManager.subscribe()` — it's called "public" because it's meant to be exposed
# client-side; the private key never leaves apps/worker's environment.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# A push subscription's endpoint+keys identify the device to the browser vendor, so
# they're encrypted at rest (packages/security's encryptAtRest/decryptAtRest) with
# this server-held key — NOT the user's KEK, which apps/worker has no way to obtain.
# Generate with: openssl rand -base64 32
PUSH_SUBSCRIPTION_ENC_KEY="CHANGE_ME_32_RANDOM_BYTES_BASE64"

# --- FCM push (apps/mobile's push notification pass) — the native-app path, the
# only one that can wake a fully-closed Android app (Web Push cannot). Read by
# apps/worker only (apps/web never sends a push itself, same as the VAPID keys
# above). Get this from the Firebase console: Project settings -> Service accounts
# -> Generate new private key — that downloads one JSON file; paste its ENTIRE
# contents here as a single-line value (not a file path — same "everything through
# env vars" convention every other secret on this page uses). Unset = FCM push
# silently disabled (apps/worker logs this at startup and moves on), same graceful-
# degradation contract TURN_SHARED_SECRET/VAPID_* above already have.
FCM_SERVICE_ACCOUNT_JSON=""

# --- apps/web ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"

# --- General ---
NODE_ENV="development"
PORT="4000"
WEB_ORIGIN="http://localhost:3000"
